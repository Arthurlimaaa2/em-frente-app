{
  "name": "CardTemplate",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ]
    },
    "title": {
      "type": "string"
    },
    "category_key": {
      "type": "string"
    },
    "anchor_phrase": {
      "type": "string"
    },
    "thought": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "situation": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "published"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "type",
    "title",
    "category_key",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
