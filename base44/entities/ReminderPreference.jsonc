{
  "name": "ReminderPreference",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "time_local": {
      "type": "string",
      "default": "20:00"
    },
    "weekdays": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "random",
        "favorite",
        "fixed"
      ],
      "enumColors": [
        "blue",
        "pink",
        "purple"
      ],
      "default": "random"
    },
    "selected_card_id": {
      "type": "string"
    },
    "show_sensitive_on_lockscreen": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "enabled"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
